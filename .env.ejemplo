# Qué necesita la app. Copiar este archivo como `.env` y completar.
#
# `.env` está en .gitignore y no se sube nunca. Este ejemplo sí se versiona:
# es la lista de lo que hay que conseguir.
#
# En Vercel estas mismas variables se cargan en Settings → Environment
# Variables, no en un archivo.

# ---------------------------------------------------------------------------
# El servicio de render (lo que llama n8n)
# ---------------------------------------------------------------------------

# Usuario y clave para entrar al servicio. Son los que después se cargan en la
# credencial de n8n, que ya existe porque htmlcsstoimage también usaba
# autenticación básica.
#
# Si quedan vacías el servicio no pide nada, que sirve para probar en la
# máquina pero no para dejarlo con dirección pública.
SERVICIO_USUARIO=
SERVICIO_CLAVE=

# La dirección pública del servicio, para armar las URL que devuelve.
# En Vercel no hace falta: se deduce del propio pedido.
SERVICIO_URL=

# Dónde quedan las piezas entre que se generan y que n8n las baja.
# En Vercel lo pone solo al conectar un almacén de Blob; en la máquina no se
# usa, porque ahí alcanza con el disco.
BLOB_READ_WRITE_TOKEN=

# Ruta a Chrome, si está en un lugar raro. Normalmente se encuentra solo, y en
# Vercel no se usa porque va el Chrome empaquetado.
CHROME=

# ---------------------------------------------------------------------------
# Lo que usa n8n hoy. No hace falta para el servicio de render: está acá
# porque los módulos que leen Monday y el Documento Maestro quedaron escritos.
# ---------------------------------------------------------------------------

# Monday: el aviso, los datos del programa y el estado de vuelta.
# Avatar → Developers → My Access Tokens.
MONDAY_API_KEY=

# Google Docs y Drive: leer el Documento Maestro, bajar imágenes, subir piezas.
# Es una cuenta de servicio: se baja un JSON y se le comparten las carpetas.
GOOGLE_CUENTA_SERVICIO=

# Gemini: redactar los "¿Qué aprenderás?" del diseño 2.
# Google AI Studio.
GEMINI_API_KEY=

# HeyGen: la locución y los avatares (el flujo de video, más adelante).
# Ojo: es la clave del panel de desarrolladores, y el saldo de la API se carga
# aparte de los planes web.
HEYGEN_API_KEY=
