{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.mjs": {
      "memory": 2048,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1/image", "destination": "/api/imagen" },
    { "source": "/i/:archivo", "destination": "/api/pieza?archivo=:archivo" }
  ]
}
